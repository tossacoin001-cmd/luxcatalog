# --- Database (Neon Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- Auth (Better Auth, our own login) ---
# Generate with: openssl rand -base64 32   (never reuse between environments)
BETTER_AUTH_SECRET=
# Public URL of this deployment, e.g. https://luxcatalog.vercel.app
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# --- Email (any SMTP; Gmail app password now, Resend/Zoho after the domain) ---
# Leave empty locally: emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Lux Catalog <you@example.com>"

# --- Cloudflare Turnstile (optional bot check on sign-in/up/reset) ---
# Both must be set together, or both left empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Scheduled jobs ---
# Vercel Cron sends this as a Bearer token to /api/cron/daily.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Payments / AI / storage (unchanged) ---
STRIPE_SECRET_KEY=
ANTHROPIC_API_KEY=
