generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  real_estate
  supercar
  yacht
  decor
  commercial
  lifestyle
  shortlet
  executive_services
}

// How a listing is transacted. Drives the call to action and, later, the
// booking engine: sale (buy outright), rent (monthly/annual lease),
// booking (by night/day/hour/slot, paid online), request (quote only, e.g.
// private jets).
enum ListingMode {
  sale
  rent
  booking
  request
}

enum ListingStatus {
  available
  under_offer
  sold
}

enum InquiryStatus {
  new
  in_progress
  closed
}

enum OrderStatus {
  pending
  paid
  fulfilled
  cancelled
}

enum PaymentProvider {
  stripe
  paystack
}

model Listing {
  id           String        @id @default(uuid())
  title        String
  slug         String        @unique
  category     Category
  description  String
  price        Decimal?
  priceDisplay String
  location     String
  country      String
  images       String[]
  specs        Json
  features     String[]
  status       ListingStatus @default(available)
  featured     Boolean       @default(false)
  mode         ListingMode   @default(sale)
  // Sub-collection within the category (src/lib/taxonomy.ts), e.g.
  // "luxury_shortlets", "car_rental", "boat_cruises", "aqua_homes".
  subcategory  String?

  // Clerk userId of the partner who submitted this listing. Null means it was
  // created directly by full admin (a "house" listing), not a partner.
  ownerId String?

  // Gates public catalog visibility. Admin-created listings default to live;
  // partner submissions start unpublished and wait for admin approval after
  // AI optimization runs, so nothing partner-submitted goes live unsupervised.
  published Boolean @default(true)

  // Dual-purpose: a supercar (or any asset) can be for sale AND available for
  // chauffeur-driven hire (Lux Drive) without needing a separate listing/category.
  hireAvailable   Boolean  @default(false)
  hireRatePerDay  Decimal?
  hireRateDisplay String?

  // Partner pricing agreement. When true, the partner is asking the platform
  // to add its margin before this goes live, price/priceDisplay stay editable
  // by admin until approval. partnerRequestedPrice keeps the partner's original
  // ask on record even after admin sets the final price, so nothing silently
  // changes without a trail either side can point back to.
  marginRequested       Boolean  @default(false)
  partnerRequestedPrice Decimal?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  savedBy          SavedListing[]
  inquiries        Inquiry[]
  unavailableDates UnavailableDate[]
  bookingSettings  BookingSettings?
  bookings         Booking[]
  orderItems       OrderItem[]
}

// A partner's public identity. Created by the partner themselves the first
// time they access the admin app, required before they can submit a listing
// so every approved listing can carry real attribution instead of going out
// anonymously. featured controls whether they appear in the public "Trusted
// Partners" strip.
model PartnerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  brandName String
  logo      String?
  bio       String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Manually blocked date ranges for shortlet listings (e.g. Aqua). Booking
// stays inquiry-based for v1 — this only powers the "unavailable" calendar
// state shown to guests, not a live payment/reservation system.
// Dates a listing can't be booked. Whole days at UTC midnight; endDate is
// exclusive (a block from the 20th to the 22nd frees the 22nd). source is
// "manual" (partner/admin) now; Airbnb calendar sync adds "ical" later.
model UnavailableDate {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  note      String?
  source    String   @default("manual")
  createdAt DateTime @default(now())

  @@index([listingId, startDate])
}

enum CancellationPolicy {
  flexible
  moderate
  strict
}

// How a bookable listing (shortlets, aqua homes, car rental, chauffeur...)
// is priced and booked online. One row per listing; absent or enabled=false
// means the listing is enquiry-only. Money is NGN.
model BookingSettings {
  listingId          String             @id
  listing            Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  enabled            Boolean            @default(false)
  // "night" (stays: checkout day is free) or "day" (hire: every day counts)
  unit               String             @default("night")
  rate               Decimal            @db.Decimal(14, 2)
  cleaningFee        Decimal            @default(0) @db.Decimal(14, 2)
  cautionDeposit     Decimal            @default(0) @db.Decimal(14, 2)
  minUnits           Int                @default(1)
  maxUnits           Int                @default(30)
  maxGuests          Int?
  instantBook        Boolean            @default(true)
  cancellationPolicy CancellationPolicy @default(moderate)
  checkInTime        String             @default("14:00")
  checkOutTime       String             @default("11:00")
  // Chauffeur hours included per day (car rental / chauffeur)
  hoursPerDay        Int?
  advanceNoticeHours Int                @default(24)
  // Ask guests to upload ID after booking (on by default for stays)
  requireGuestId     Boolean            @default(true)
  updatedAt          DateTime           @updatedAt
}

model SavedListing {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Inquiry {
  id        String        @id @default(uuid())
  listingId String?
  listing   Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  userId    String?
  name      String
  email     String
  phone     String?
  message   String
  status    InquiryStatus @default(new)

  // Populated for shortlet (Aqua) requests-to-book and Lux Drive/Escort/Arrival
  // date-bound service requests. Null for ordinary asset enquiries.
  checkIn  DateTime?
  checkOut DateTime?

  createdAt DateTime @default(now())
}

// Single-row cache of the NGN->USD rate so the storefront currency toggle
// doesn't call a live FX API on every request. Refreshed by a scheduled job.
model FxRate {
  id        String   @id @default(uuid())
  base      String   @default("NGN")
  quote     String   @default("USD")
  rate      Decimal
  source    String?
  updatedAt DateTime @updatedAt
}

// Real cart + checkout + delivery for Interior Decor. Separate from the
// Listing/Inquiry "reserve with a holding deposit" pattern used by
// real estate/cars/jets/yachts, which stays inquiry-based.
model Order {
  id              String          @id @default(uuid())
  userId          String?
  email           String
  phone           String?
  currency        String          @default("NGN")
  subtotal        Decimal
  shippingFee     Decimal
  total           Decimal
  shippingName    String
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingCountry String
  paymentProvider PaymentProvider
  paymentRef      String?
  status          OrderStatus     @default(pending)
  items           OrderItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId     String
  listing       Listing @relation(fields: [listingId], references: [id])
  titleSnapshot String
  priceSnapshot Decimal
  quantity      Int     @default(1)
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth). Users, sessions and credentials live in this
// database, owned by Lux Catalog, no third-party identity provider. Table
// shapes follow Better Auth's core schema + twoFactor plugin; ids for users
// imported from Clerk keep their original "user_..." id so every existing
// ownerId / userId reference (listings, partner profiles, saved items,
// enquiries, orders) stays linked.
// ---------------------------------------------------------------------------

enum UserRole {
  customer
  partner
  // Lux Catalog staff: runs operations in the admin panel, but cannot manage
  // the team. Never goes through the partner application or agreement.
  team
  admin
}

model User {
  id               String                  @id
  name             String
  email            String                  @unique
  emailVerified    Boolean                 @default(false)
  image            String?
  phone            String?
  // Never accepted from sign-up input (input: false in auth config), only
  // changed by an admin or by redeeming a staff invitation.
  role             UserRole                @default(customer)
  // Areas a team member may use (lib/access). Ignored for other roles.
  permissions      String[]                @default([])
  twoFactorEnabled Boolean?                @default(false)
  // Marketing consent (Nigeria Data Protection Act 2023): only users who
  // opted in receive the customer "Lux Edit". Service and account emails
  // don't need it.
  marketingConsent Boolean                 @default(false)
  consentAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  notificationPref NotificationPreference?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Password hash (scrypt), never the password itself.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // false until the user proves the authenticator works (first code).
  verified                Boolean?  @default(true)
  // Locks code entry after repeated wrong guesses.
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
}

// Stored in the database (not memory) because serverless instances don't
// share memory, an in-memory limiter would reset on every cold start.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Staff invitations (admin / partner), replacing Clerk organization invites.
// Only a SHA-256 hash of the token is stored, the raw token exists only in
// the link handed to the invitee.
model StaffInvitation {
  id          String    @id @default(uuid())
  email       String
  role        UserRole
  // Areas the team member gets on accepting (lib/access).
  permissions String[]  @default([])
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

// Append-only record of security-relevant admin actions (role changes,
// invites, removals) so access changes always have a trail.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  target    String?
  detail    Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Notifications & Watchdog
// ---------------------------------------------------------------------------

enum DigestFrequency {
  daily
  weekly
  off
}

// One row per user, created lazily the first time a digest considers them.
// unsubscribeToken powers one-click unsubscribe links without a login.
model NotificationPreference {
  id               String          @id @default(uuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  luxEdit          DigestFrequency @default(weekly)
  partnerDigest    Boolean         @default(true)
  adminBriefing    Boolean         @default(true)
  instantAlerts    Boolean         @default(true)
  unsubscribeToken String          @unique
  updatedAt        DateTime        @updatedAt
}

// Every email the system sends (or deliberately skips), for the admin
// briefing, the Watchdog's failed-delivery check, and to avoid double sends.
model EmailLog {
  id        String   @id @default(uuid())
  userId    String?
  to        String
  kind      String
  subject   String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, kind, createdAt])
}

// Lightweight listing view events: powers partner stats ("42 views today")
// and personalised picks. visitorId is a random first-party cookie, never
// tied to anything outside this site.
model ListingView {
  id        String   @id @default(uuid())
  listingId String
  userId    String?
  visitorId String
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([userId, createdAt])
  @@index([visitorId, listingId, createdAt])
}

model WatchdogRun {
  id        String   @id @default(uuid())
  kind      String
  ok        Boolean
  checks    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Commission the platform takes, deducted from the partner payout (clients
// always see one all-inclusive price). Resolution order when a booking/sale
// is priced: partner + subcategory > partner + category > partner >
// subcategory > category > mode default. Every booking stores the rate it
// was charged, so later changes never rewrite history.
model CommissionRule {
  id           String       @id @default(uuid())
  partnerId    String?
  category     Category?
  subcategory  String?
  mode         ListingMode?
  ratePercent  Decimal      @db.Decimal(5, 2)
  // after_checkin: released ~24h after the stay/service starts (Airbnb-style)
  // after_completion: released when it ends (new partners, higher risk)
  // on_completion_of_sale: sales, released once the transfer completes
  payoutTiming String       @default("after_checkin")
  notes        String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([partnerId])
  @@index([category, subcategory])
}

// ---------------------------------------------------------------------------
// Partner programme: "Become a Partner" applications and their private
// documents. Requirements per partner type live in
// src/lib/partner-requirements.ts.
// ---------------------------------------------------------------------------

enum PartnerType {
  property_host
  fleet_owner
  marine_operator
  chauffeur_service
  security_company
  brand_retailer
  agent
}

enum ApplicationStatus {
  draft
  submitted
  info_requested
  approved
  rejected
}

model PartnerApplication {
  id             String            @id @default(uuid())
  // One application per account; re-applying after a rejection reuses it.
  userId         String            @unique
  partnerType    PartnerType
  status         ApplicationStatus @default(draft)
  legalForm      String            @default("individual")
  businessName   String            @default("")
  contactName    String            @default("")
  phone          String            @default("")
  city           String            @default("")
  country        String            @default("Nigeria")
  website        String?
  socialHandle   String?
  cacNumber      String?
  collections    String[]
  about          String            @default("")
  yearsOperating Int?
  // Which declarations were ticked, each with the time it was accepted.
  declarations   Json?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  // Shown to the applicant (more info needed / reason for decision).
  reviewNote     String?
  // Admin-only notes, never shown to the applicant.
  internalNote   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  documents      PartnerDocument[]

  @@index([status, submittedAt])
}

// Identity, licence and insurance documents. Stored privately (Vercel Blob
// private access, or in the database as a fallback) and only ever served
// through an authenticated route to the owner or an admin.
model PartnerDocument {
  id            String             @id @default(uuid())
  applicationId String
  application   PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String
  fileName      String
  contentType   String
  size          Int
  storage       String
  blobPathname  String?
  data          Bytes?
  expiresAt     DateTime?
  status        String             @default("pending")
  note          String?
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

// A partner's signature on one version of one agreement. Keeps the exact
// text that was signed (content: the JSON string, byte for byte) and its
// SHA-256 (contentHash), so anyone can re-hash content and prove it is
// what was signed, even after the template changes. No FK to User:
// signed records are legal evidence and outlive account changes.
model PartnerAgreement {
  id           String   @id @default(uuid())
  userId       String
  agreementKey String
  version      String
  title        String
  content      String
  contentHash  String
  signedName   String
  signerEmail  String
  businessName String
  ipAddress    String?
  userAgent    String?
  signedAt     DateTime @default(now())

  @@unique([userId, agreementKey, version])
  @@index([signedAt])
}

enum BookingStatus {
  // On-request listings: waiting for the partner to accept (dates held until holdExpiresAt)
  requested
  // The partner declined the request
  declined
  // Dates held for the guest while they pay (holdExpiresAt); expired holds free the dates.
  pending_payment
  confirmed
  cancelled
  expired
  completed
}

// A guest's booking of a listing for [startDate, endDate) (endDate exclusive,
// whole days at UTC midnight). Prices are snapshotted at booking time so the
// record never changes if the listing's price does. Money is NGN.
model Booking {
  id                 String             @id @default(uuid())
  // Human reference (LUX-XXXXXX), also used as the Paystack reference.
  reference          String             @unique
  listingId          String
  listing            Listing            @relation(fields: [listingId], references: [id])
  userId             String
  guestName          String
  guestEmail         String
  guestPhone         String?
  startDate          DateTime
  endDate            DateTime
  unit               String
  units              Int
  guests             Int?
  rate               Decimal            @db.Decimal(14, 2)
  base               Decimal            @db.Decimal(14, 2)
  cleaningFee        Decimal            @db.Decimal(14, 2)
  total              Decimal            @db.Decimal(14, 2)
  cautionDeposit     Decimal            @db.Decimal(14, 2)
  amountDue          Decimal            @db.Decimal(14, 2)
  currency           String             @default("NGN")
  cancellationPolicy CancellationPolicy
  status             BookingStatus      @default(pending_payment)
  holdExpiresAt      DateTime?
  paidAt             DateTime?
  paymentChannel     String?
  // Paystack checkout link for this booking, so a guest who leaves can resume
  paymentUrl         String?
  // Paid after the hold lapsed and someone else took the dates: a person
  // must refund it (shown to admins).
  needsRefund        Boolean            @default(false)
  note               String?
  // Cancellation (guest, partner or admin)
  cancelledAt        DateTime?
  cancelledBy        String?
  cancelReason       String?
  // On-request listings: when the partner answered, and why if declined
  respondedAt        DateTime?
  declineReason      String?
  // Guest ID (shortlets): stored privately like partner documents; only the
  // guest, the listing's partner and the bookings team can open it.
  guestIdStorage     String?
  guestIdPath        String?
  guestIdData        Bytes?
  guestIdType        String?
  guestIdUploadedAt  DateTime?
  // Caution deposit after check-out: held -> claimed (partner reports
  // damage within 48h) -> refund queued / kept (in part)
  cautionStatus      String             @default("held")
  claimAmount        Decimal?           @db.Decimal(14, 2)
  claimNote          String?
  claimAt            DateTime?
  refunds            Refund[]
  payout             Payout?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([listingId, startDate])
  @@index([userId])
  @@index([status, holdExpiresAt])
}

enum RefundStatus {
  // Waiting for an admin (or team member with Bookings) to approve
  pending_approval
  // Sent to Paystack, not yet settled
  processing
  completed
  failed
  rejected
}

// Money going back to a guest. Every refund waits for a person to approve it
// before anything is sent to Paystack.
model Refund {
  id             String       @id @default(uuid())
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id])
  // cancellation | caution | payment_issue
  kind           String
  amount         Decimal      @db.Decimal(14, 2)
  reason         String
  status         RefundStatus @default(pending_approval)
  requestedById  String?
  decidedById    String?
  decidedAt      DateTime?
  paystackRefund String?
  failureReason  String?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([bookingId])
}

// Where a partner is paid. The account is checked with the bank through
// Paystack (accountName comes back from the bank) and registered as a
// Paystack transfer recipient. Only the last 4 digits are ever shown.
model PayoutAccount {
  userId        String   @id
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String
  recipientCode String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

enum PayoutStatus {
  // Waiting for its due time (e.g. 24h after check-in)
  scheduled
  // Due: waiting for an admin to approve the transfer
  pending_approval
  processing
  paid
  failed
  cancelled
}

// What a partner earns from one booking: total (excluding the caution
// deposit) minus commission, paid by Paystack Transfer once due and approved.
model Payout {
  id             String       @id @default(uuid())
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id])
  partnerId      String
  gross          Decimal      @db.Decimal(14, 2)
  commissionRate Decimal      @db.Decimal(5, 2)
  commission     Decimal      @db.Decimal(14, 2)
  amount         Decimal      @db.Decimal(14, 2)
  dueAt          DateTime
  status         PayoutStatus @default(scheduled)
  reference      String       @unique
  transferCode   String?
  decidedById    String?
  decidedAt      DateTime?
  paidAt         DateTime?
  failureReason  String?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, dueAt])
  @@index([partnerId])
}
